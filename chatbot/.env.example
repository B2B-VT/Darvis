# ── LLM (Google AI Studio) ─────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_MODEL=gemma-3-27b-it

# ── Supabase ────────────────────────────────────────────────────────────────────
# Use the service_role key (not anon) — required so RLS does not block reads.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_service_role_key_here

# ── Redis (redisvl vector store) ────────────────────────────────────────────────
# Needs Redis Stack / Redis 8+ with the search module (plain Redis won't work).
# Redis Cloud free tier works fine. Supabase `embeddings` stays the source of
# truth; run `python -m scripts.sync_redis_index` after build_embeddings.py /
# rebuild_embeddings.py (or any time Redis is cold) to (re)populate this index.
REDIS_URL=redis://default:password@host:port
RAG_REDIS_INDEX_NAME=darvis_embeddings

# ── CORS ───────────────────────────────────────────────────────────────────────
# In production set to your Vercel URL only (e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Enable /docs locally — do NOT set on Render
SHOW_DOCS=true

# ── Embedding provider ─────────────────────────────────────────────────────────
# Auto-detect order: openai → google → fastembed (local, no key needed).
# IMPORTANT: this MUST match the provider used to build the stored Supabase vectors.
# If you change it, re-run:  python -m scripts.rebuild_embeddings
#
# Options: "openai" | "google" | "local" | "" (auto-detect)
RAG_EMBEDDING_PROVIDER=

# OpenAI embedding model (only when RAG_EMBEDDING_PROVIDER=openai)
RAG_OPENAI_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Vector dimension — MUST match the stored vector dimension in Supabase.
# 384 = fastembed all-MiniLM-L6-v2 (default). 1536 = OpenAI text-embedding-3-small.
RAG_EMBEDDING_DIM=384

# ── Reranking ──────────────────────────────────────────────────────────────────
# Cohere Rerank API key (free tier: 1,000 calls/month). Recommended for production.
COHERE_API_KEY=

# Enable local cross-encoder reranker (sentence-transformers ~85 MB model).
# Keep false on Render free tier (512 MB RAM limit). Set true locally or on paid tier.
RAG_ENABLE_LOCAL_RERANKER=false

# ── RAG pipeline tuning ────────────────────────────────────────────────────────
RAG_VECTOR_WEIGHT=0.7        # hybrid RRF vector weight (0.0=keyword-only, 1.0=vector-only)
RAG_MIN_SIMILARITY=0.2       # minimum cosine similarity pre-rerank
RAG_TOP_K_RETRIEVE=20        # candidates fetched before reranking
RAG_TOP_K_RERANK=5           # chunks passed to LLM after reranking

RAG_ENABLE_QUERY_REWRITE=true    # LLM-powered query expansion (~100-300 ms)
RAG_REWRITE_TIMEOUT_S=3.0        # hard timeout for query rewrite LLM call
RAG_INTENT_TIMEOUT_S=5.0         # hard timeout for intent extraction LLM call

# Ask Gemma whether borderline-quality retrieved context actually answers the
# question before using it (vs. blindly accepting "best available"). Only
# fires on the last critic attempt when heuristic quality is ambiguous.
RAG_ENABLE_LLM_JUDGE=true

# Skip embedding provider/dimension consistency check at startup.
# Set true only during local dev when intentionally using a mismatched provider.
RAG_SKIP_EMBEDDING_VALIDATION=false

RAG_DEBUG_MODE=false             # full per-request retrieval telemetry (for /retrieval/debug)
