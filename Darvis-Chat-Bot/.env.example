# LLM — get your key at aistudio.google.com
GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_MODEL=gemma-3-27b-it

# Supabase — use the service_role key (not the anon key) so RLS doesn't block reads
# Find both at: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_service_role_key_here

# Origins allowed to call this API (comma-separated)
# In production on Render, set this to your Vercel frontend URL only
# e.g. ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Enable /docs locally — do NOT set this on Render
SHOW_DOCS=true
