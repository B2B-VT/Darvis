+            ), rejected
+        checked = er.resolve_professors_for_course(name_candidate, subject, course_no)
+        if checked.ambiguous:
+            return QueryPlan(
+                route="professor_profile",
+                capabilities=["instructor_lookup"],
+                confidence=1.0,
+                subject=subject,
+                course_no=course_no,
+                professor_name=name_candidate,
+                needs_clarification=True,
+                clarifying_question=(
