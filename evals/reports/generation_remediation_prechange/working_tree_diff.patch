+def _explicit_prompt_injection_attempt(question: str) -> bool:
+    q = question.lower()
+    return any(
+        phrase in q
+        for phrase in (
+            "ignore previous instructions",
+            "ignore all previous instructions",
+            "bypass filters",
+            "override retrieval",
+            "make up",
+            "invent records",
+            "invent a professor",
